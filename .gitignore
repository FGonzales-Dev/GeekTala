# Supabase (local secrets/state — config.toml itself is safe to commit)
supabase/.branches/
supabase/.temp/
supabase/.env
supabase/.env.*

# PowerSync local dev overrides
powersync/.env
powersync/.env.*
powersync/config/*.local.yaml
